<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RS-6 launchd recipe for the resident `space up` station
  (the_grid/docs/SCRATCH-resident-station.md D-R3). A TEMPLATE, not a
  finished artifact — every CHANGE_ME below is operator-filled before this
  is installed. See space_station/README.md "Resident operation" for the
  full compile/install/start/stop/status/logs/lock/crash-recovery runbook.

  There is deliberately no `space install` command yet: a template earns
  automation after it has been operated by hand.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>engineering.memento.space</string>

	<key>ProgramArguments</key>
	<array>
		<string>/CHANGE_ME/path/to/space_station/space</string>
		<string>up</string>
		<string>--state-workspace</string>
		<string>/CHANGE_ME/path/to/tgdog</string>
		<string>--substation</string>
		<string>CHANGE_ME-substation</string>
		<string>--root</string>
		<string>CHANGE_ME-substation=/CHANGE_ME/path/to/the_grid</string>
		<string>--root</string>
		<string>power_station=/CHANGE_ME/path/to/power_station</string>
		<string>--root</string>
		<string>space_station=/CHANGE_ME/path/to/space_station</string>
		<string>--root</string>
		<string>genesis=/CHANGE_ME/path/to/genesis</string>
		<string>--no-dry-run</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/CHANGE_ME/path/to/the_grid</string>

	<!--
	  SuccessfulExit=false, NOT a bare `true`: launchd only relaunches on a
	  non-zero/signal exit. A graceful `space down` (SIGTERM -> clean exit 0)
	  is then a REAL stop, not an instant bounce; `kill -9` / a crash (exit
	  via signal / non-zero) IS relaunched. See README "Resident operation".
	-->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/CHANGE_ME/Users/you/Library/Logs/space_station/space.out.log</string>

	<key>StandardErrorPath</key>
	<string>/CHANGE_ME/Users/you/Library/Logs/space_station/space.err.log</string>
</dict>
</plist>
